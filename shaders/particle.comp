#version 450

// Particle structure
struct Particle {
    vec3 position;
    float temperature;
    vec3 velocity;
    float density;
};

// Shader storage buffer for particles
layout(binding = 0, std430) buffer ParticleBuffer {
    Particle particles[];
} particleBuffer;

// Push constants
layout(push_constant) uniform PushConstants {
    float deltaTime;
    float time;
    uint particleCount;
    float gravityStrength;
    vec3 gravityCenter;
    float turbulenceStrength;
    float dampingFactor;
    uint constraintShape;  // 0=NONE, 1=SPHERE, 2=DISC, 3=TORUS, 4=ACCRETION_DISK
    float constraintRadius;
    float constraintThickness;
    float blackHoleMass;  // In solar masses
    float alphaViscosity; // Shakura-Sunyaev alpha parameter
    float angularMomentumBoost; // Boost orbital velocity for stable orbits
} push;

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Constraint physics functions
void applyConstraints(inout vec3 position, inout vec3 velocity) {
    if (push.constraintShape == 1u) { // SPHERE
        float distance = length(position);
        if (distance > push.constraintRadius && distance > 0.001) {
            // Project particle back onto sphere surface
            vec3 normal = position / distance; // Safe normalize
            position = normal * push.constraintRadius * 0.99; // Slightly inside
            // Reflect velocity
            velocity = reflect(velocity, -normal) * 0.8; // Some energy loss
        }
    }
    else if (push.constraintShape == 2u) { // DISC
        float radiusXZ = length(position.xz);
        float thickness = push.constraintThickness * 0.5; // Half thickness above/below center
        
        // Radial constraint
        if (radiusXZ > push.constraintRadius && radiusXZ > 0.001) {
            vec2 normalXZ = position.xz / radiusXZ; // Safe normalize
            position.xz = normalXZ * push.constraintRadius * 0.99;
            vec2 velXZ = velocity.xz;
            velXZ = reflect(velXZ, -normalXZ) * 0.8;
            velocity.xz = velXZ;
        }
        
        // Thickness constraint
        if (abs(position.y) > thickness) {
            float normalY = sign(position.y);
            position.y = normalY * thickness * 0.99;
            velocity.y = -velocity.y * 0.6; // Damped reflection
        }
    }
    else if (push.constraintShape == 3u) { // TORUS  
        float radiusXZ = length(position.xz);
        float majorRadius = push.constraintRadius;
        float minorRadius = push.constraintThickness;
        
        // Avoid division by zero for particles at center
        if (radiusXZ < 0.001) {
            radiusXZ = 0.001;
        }
        
        // Distance to torus center line in XZ plane
        vec2 dirXZ = position.xz / radiusXZ; // Safe normalize
        vec3 torusCenter = vec3(dirXZ * majorRadius, 0.0);
        vec3 toCenter = position - torusCenter;
        float distToTorus = length(toCenter);
        
        if (distToTorus > minorRadius) {
            // Project back onto torus surface
            if (distToTorus > 0.001) {
                vec3 normal = toCenter / distToTorus; // Safe normalize
                position = torusCenter + normal * minorRadius * 0.99;
                velocity = reflect(velocity, -normal) * 0.7;
            }
        }
        
        // Handle case where particle is too close to center (inside donut hole)
        if (radiusXZ < majorRadius - minorRadius) {
            position.xz = dirXZ * (majorRadius - minorRadius) * 0.99;
            vec2 velXZ = velocity.xz;
            velXZ = reflect(velXZ, -dirXZ) * 0.8;
            velocity.xz = velXZ;
        }
    }
}

void main() {
    uint id = gl_GlobalInvocationID.x;

    // Bounds check
    if (id >= push.particleCount) {
        return;
    }

    Particle p = particleBuffer.particles[id];

    // Calculate force towards center
    vec3 toCenter = push.gravityCenter - p.position;
    float distance = length(toCenter);

    // Prevent division by zero and singularity
    distance = max(distance, 0.1);
    
    vec3 gravityForce;
    float ISCO = 3.0; // Innermost stable circular orbit at 3 Schwarzschild radii
    
    if (push.constraintShape == 4u) { // ACCRETION_DISK mode
        // Paczynski-Wiita pseudo-Newtonian potential
        // Mimics relativistic effects near black hole
        float r_s = 0.5 * push.blackHoleMass; // Schwarzschild radius (scaled down)
        float effectiveRadius = max(distance - r_s, 0.5);
        
        // Gentler gravity with better falloff
        float gravityMagnitude = push.gravityStrength * push.blackHoleMass / (effectiveRadius * effectiveRadius + 1.0);
        gravityForce = normalize(toCenter) * gravityMagnitude * 0.3; // Reduced strength
        
        // Sink particles inside ISCO but more gradually
        if (distance < ISCO * r_s) {
            // Gradual inward pull
            float sinkFactor = 1.0 + 2.0 * (1.0 - distance / (ISCO * r_s));
            gravityForce *= sinkFactor;
            p.temperature = mix(p.temperature, 2.0, 0.01); // Gradual heating
        }
    } else {
        // Standard Newtonian gravity for other modes
        float gravityMagnitude = push.gravityStrength / (distance * distance + 1.0);
        gravityForce = normalize(toCenter) * gravityMagnitude;
        
        // Add repulsion when too close to center (prevents singularity/slingshot)
        if (distance < 1.0) {
            float repulsionStrength = 2.0 * (1.0 - distance);
            gravityForce -= normalize(toCenter) * repulsionStrength;
        }
    }

    // Calculate proper orbital velocity (perpendicular to radius)
    vec3 tangent = cross(normalize(toCenter), vec3(0.0, 1.0, 0.0));
    if (length(tangent) < 0.1) {
        tangent = cross(normalize(toCenter), vec3(1.0, 0.0, 0.0));
    }
    tangent = normalize(tangent);

    vec3 orbitalCorrection;
    if (push.constraintShape == 4u) { // ACCRETION_DISK mode
        // Keplerian orbital velocity with relativistic correction
        float r_s = 0.5 * push.blackHoleMass;
        float keplerianSpeed = sqrt(push.gravityStrength * push.blackHoleMass / (distance + 0.5));
        
        // Smoother orbital velocity targeting
        float targetOrbitalSpeed = keplerianSpeed * 0.7; // Reduced for stability
        
        // Much gentler α-viscosity for slower inward spiral
        float viscousForce = push.alphaViscosity * 0.01; // Reduced by 10x
        vec3 radialDrift = -normalize(toCenter) * viscousForce;
        
        float currentSpeed = length(p.velocity);
        orbitalCorrection = tangent * (targetOrbitalSpeed - currentSpeed) * 0.02 + radialDrift;
        
        // Apply angular momentum boost for better particle distribution
        orbitalCorrection += tangent * push.angularMomentumBoost * 0.1;
    } else {
        // Standard orbital correction for other modes with angular momentum boost
        float currentSpeed = length(p.velocity);
        float targetOrbitalSpeed = sqrt(push.gravityStrength / (distance + 1.0));
        orbitalCorrection = tangent * (targetOrbitalSpeed - currentSpeed) * 0.02;
        
        // Apply angular momentum boost for better particle distribution in ALL modes
        orbitalCorrection += tangent * push.angularMomentumBoost * 0.08;
    }

    // Apply forces
    vec3 acceleration = gravityForce + orbitalCorrection;

    // REALISTIC 3D NOISE-BASED TURBULENCE
    // Multi-octave noise for natural-looking turbulence patterns
    vec3 noisePos = p.position * 0.1 + vec3(push.time * 0.1);
    
    // 3D Simplex-like noise using multiple sine waves at different frequencies
    vec3 turbulence1 = vec3(
        sin(noisePos.x * 3.14) * cos(noisePos.y * 2.71) * sin(noisePos.z * 1.41),
        cos(noisePos.x * 2.71) * sin(noisePos.y * 3.14) * cos(noisePos.z * 1.73),
        sin(noisePos.x * 1.73) * sin(noisePos.y * 1.41) * cos(noisePos.z * 2.71)
    );
    
    // Higher frequency detail layer
    vec3 noisePos2 = p.position * 0.3 + vec3(push.time * 0.15);
    vec3 turbulence2 = vec3(
        sin(noisePos2.x * 7.1) * cos(noisePos2.y * 6.3) * sin(noisePos2.z * 5.7),
        cos(noisePos2.x * 6.3) * sin(noisePos2.y * 7.1) * cos(noisePos2.z * 4.9),
        sin(noisePos2.x * 5.7) * sin(noisePos2.y * 4.9) * cos(noisePos2.z * 6.3)
    ) * 0.3;
    
    // Combine octaves for realistic turbulence
    vec3 combinedTurbulence = (turbulence1 + turbulence2) * push.turbulenceStrength;
    acceleration += combinedTurbulence;

    // Update velocity with damping
    p.velocity += acceleration * push.deltaTime;
    p.velocity *= push.dampingFactor;
    
    // Clamp velocity to prevent extreme speeds - MUCH slower for stable orbits
    float maxSpeed = 2.0; // Reduced from 5.0
    float velMagnitude = length(p.velocity);
    if (velMagnitude > maxSpeed) {
        p.velocity = normalize(p.velocity) * maxSpeed;
    }
    
    // Add slight particle repulsion to prevent complete overlap
    if (push.constraintShape == 4u) { // Only in accretion disk mode
        // Simple spacing force to spread particles
        vec3 spacingForce = vec3(0.0);
        float minDistance = 0.1;
        
        // Add small random offset based on particle position
        vec3 pseudoRandom = sin(p.position * 123.456) * 0.01;
        spacingForce += pseudoRandom;
        
        p.velocity += spacingForce;
    }

    // Update position
    p.position += p.velocity * push.deltaTime;

    // Apply shape constraints only if enabled
    if (push.constraintShape != 0u) {
        applyConstraints(p.position, p.velocity);
    }

    // Update temperature and density for accretion disk
    if (push.constraintShape == 4u) { // ACCRETION_DISK mode
        // ORBITAL VELOCITY-BASED TEMPERATURE MODEL
        // Based on 2025 research: temperature from orbital mechanics, not distance
        
        float speed = length(p.velocity);
        vec3 radialDirection = normalize(toCenter);
        
        // Calculate orbital velocity (perpendicular to radius)
        vec3 orbitalVelocity = p.velocity - dot(p.velocity, radialDirection) * radialDirection;
        float orbitalSpeed = length(orbitalVelocity);
        
        // Keplerian velocity for circular orbit at this radius
        float keplerianVel = sqrt(push.gravityStrength * push.blackHoleMass / (distance + 0.5));
        
        // Temperature based on orbital shear and velocity deviation
        // Higher temperature when orbital velocity deviates from Keplerian
        float velocityDeviation = abs(orbitalSpeed - keplerianVel) / keplerianVel;
        float shearHeating = velocityDeviation * 0.5;
        
        // Viscous dissipation heating (from α-viscosity model)
        float viscousHeating = push.alphaViscosity * orbitalSpeed * orbitalSpeed * 0.1;
        
        // CONSERVATIVE TEMPERATURE MODEL - white only at extremes
        // Much gentler heating for stable colors across all modes
        float densityBoost = min(p.density * 0.1, 0.05); // Much smaller density effect
        
        // Rare extreme conditions for white hot cores
        float extremeVelocity = max(0.0, (speed - 1.5) * 0.2); // Only very high velocities
        float extremeShear = max(0.0, (shearHeating - 0.3) * 0.3); // Only extreme shear
        
        // Combine heating sources - much more conservative
        float baseTemp = shearHeating + viscousHeating + 0.05;
        float extremeBonus = (extremeVelocity + extremeShear + densityBoost) * 0.5;
        float newTemp = baseTemp + extremeBonus;
        
        // Very gradual temperature evolution to maintain stable colors
        p.temperature = mix(p.temperature, newTemp, 0.02);
        p.temperature = clamp(p.temperature, 0.05, 0.85); // Cap at 85% - white very rare
        
        // Gentler density profile
        float normalizedRadius = max(distance / 10.0, 0.1);
        p.density = 0.5 / pow(normalizedRadius, 0.3);
        p.density = clamp(p.density, 0.0, 2.0);
    } else {
        // ENHANCED STANDARD MODE TEMPERATURE - same white hot capability
        float speed = length(p.velocity);
        
        // Base temperature from velocity
        float baseTemp = speed * 0.08 + 0.05; // Conservative base
        
        // Extreme velocity bonus for white hot cores
        float extremeVelocity = max(0.0, (speed - 1.8) * 0.3); // Only very high speeds
        
        // Distance-based heating (closer = hotter, but capped)
        float proximityHeat = max(0.0, (3.0 - distance) * 0.05); // Gentle proximity bonus
        
        // Combine for final temperature
        float newTemp = baseTemp + extremeVelocity + proximityHeat;
        
        // Gradual temperature evolution
        p.temperature = mix(p.temperature, newTemp, 0.03);
        p.temperature = clamp(p.temperature, 0.05, 0.85); // Same cap as accretion mode
        
        // Standard density
        p.density = 1.0 / (distance * 0.1 + 1.0);
    }

    // Write back
    particleBuffer.particles[id] = p;
}
