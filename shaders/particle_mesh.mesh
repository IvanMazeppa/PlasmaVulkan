#version 450
#extension GL_EXT_mesh_shader : require

// Mesh shader for particle billboard generation
// This completely replaces traditional vertex/index buffers!

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 128, max_primitives = 64) out;

// Particle data structure (matches CPU ParticleSystem structure)
struct Particle {
    vec3 position;      // 12 bytes - xyz position
    float temperature;  // 4 bytes - temperature
    vec3 velocity;      // 12 bytes - xyz velocity  
    float density;      // 4 bytes - density
};

// Input particle buffer (from compute shader)
layout(set = 0, binding = 0) restrict readonly buffer ParticleBuffer {
    Particle particles[];
};

// Push constants for rendering parameters
layout(push_constant) uniform PushConstants {
    mat4 viewProj;
    vec3 cameraPos;
    float particleSize;
    uint particleCount;
    float time;
} pc;

// Per-vertex outputs to fragment shader
layout(location = 0) out vec4 fragColor[];
layout(location = 1) out vec2 fragUV[];
layout(location = 2) out vec3 fragWorldPos[];

void main() {
    uint particleIndex = gl_WorkGroupID.x * gl_WorkGroupSize.x + gl_LocalInvocationID.x;
    uint localThreadIndex = gl_LocalInvocationID.x;
    
    // Count how many particles this workgroup will process
    uint particlesInWorkgroup = min(gl_WorkGroupSize.x, pc.particleCount - gl_WorkGroupID.x * gl_WorkGroupSize.x);
    
    // Each workgroup outputs geometry for ALL its particles at once
    // Total vertices = 4 per particle, Total primitives = 2 per particle  
    SetMeshOutputsEXT(particlesInWorkgroup * 4, particlesInWorkgroup * 2);
    
    // Early exit if this thread has no particle to process
    if (particleIndex >= pc.particleCount) {
        return;
    }
    
    Particle p = particles[particleIndex];
    
    // No culling - render ALL particles for fair performance comparison
    vec3 toCamera = pc.cameraPos - p.position;
    float distance = length(toCamera);
    
    float velocityMagnitude = length(p.velocity);
    
    // Match traditional renderer's point size calculation
    // Convert from screen pixels to world space at this distance
    float screenSize = pc.particleSize * (25.0 / (distance + 1.0));
    screenSize = clamp(screenSize, 4.0, 40.0); // Same clamps as traditional renderer
    
    // Convert screen pixels to world space size
    // Approximate conversion: pixels to world units based on distance and FOV
    float size = screenSize * distance * 0.00025; // 50% smaller particles for better comparison
    
    // Ensure minimum visible size - prevent particles from becoming invisible
    size = max(size, 0.05); // Also reduce minimum size by 50%
    
    // Generate temperature-based color (matches traditional renderer exactly)
    float normalizedTemp = clamp(p.temperature, 0.0, 1.0);
    vec3 color;
    
    if (normalizedTemp < 0.15) {
        color = vec3(0.1, 0.3, 0.9);        // Very cool: Deep blue
    } else if (normalizedTemp < 0.3) {
        color = vec3(0.2, 0.6, 1.0);        // Cool: Cyan-blue  
    } else if (normalizedTemp < 0.45) {
        color = vec3(0.3, 0.8, 0.9);        // Moderate cool: Cyan
    } else if (normalizedTemp < 0.6) {
        color = vec3(0.9, 0.9, 0.6);        // Moderate: White-yellow
    } else if (normalizedTemp < 0.75) {
        color = vec3(1.0, 0.7, 0.1);        // Moderate hot: Yellow-orange
    } else if (normalizedTemp < 0.88) {
        color = vec3(1.0, 0.4, 0.0);        // Hot: Orange
    } else {
        color = vec3(1.0, 0.1, 0.0);        // Very hot: Red
    }
    
    // Billboard orientation (always face camera)
    vec3 forward = normalize(toCamera);
    vec3 right = normalize(cross(forward, vec3(0.0, 1.0, 0.0)));
    vec3 up = cross(right, forward);
    
    // Generate 4 vertices for billboard quad
    vec3 positions[4] = {
        p.position + (-right - up) * size,  // Bottom-left
        p.position + ( right - up) * size,  // Bottom-right  
        p.position + (-right + up) * size,  // Top-left
        p.position + ( right + up) * size   // Top-right
    };
    
    vec2 uvs[4] = {
        vec2(0.0, 0.0),  // Bottom-left
        vec2(1.0, 0.0),  // Bottom-right
        vec2(0.0, 1.0),  // Top-left  
        vec2(1.0, 1.0)   // Top-right
    };
    
    // Each thread outputs its 4 vertices at the correct offset
    uint vertexOffset = localThreadIndex * 4;
    for (uint i = 0; i < 4; i++) {
        uint vertexIndex = vertexOffset + i;
        gl_MeshVerticesEXT[vertexIndex].gl_Position = pc.viewProj * vec4(positions[i], 1.0);
        fragColor[vertexIndex] = vec4(color, 1.0);
        fragUV[vertexIndex] = uvs[i];
        fragWorldPos[vertexIndex] = positions[i];
    }
    
    // Each thread outputs its 2 triangles at the correct offset
    uint primitiveOffset = localThreadIndex * 2;
    gl_PrimitiveTriangleIndicesEXT[primitiveOffset + 0] = uvec3(vertexOffset + 0, vertexOffset + 1, vertexOffset + 2);
    gl_PrimitiveTriangleIndicesEXT[primitiveOffset + 1] = uvec3(vertexOffset + 1, vertexOffset + 3, vertexOffset + 2);
}