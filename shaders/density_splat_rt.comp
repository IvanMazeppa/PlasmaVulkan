#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Push constants for density splatting
layout(push_constant) uniform PushConstants {
    vec3 gridOrigin;
    float voxelSize;
    uvec3 gridDimensions;
    uint particleCount;
    float splatRadius;
    float _padding1;
    float _padding2;
    float _padding3;
} pc;

// Particle data (position, velocity, etc.)
layout(set = 0, binding = 0) readonly buffer ParticleBuffer {
    vec4 positions[];  // xyz = position, w = mass or density
} particles;

// 3D density grid for splatting
layout(set = 0, binding = 1, r16f) uniform image3D densityGrid;

void main() {
    uint particleIndex = gl_GlobalInvocationID.x;

    // Bounds check - guard against empty workgroups
    if (particleIndex >= pc.particleCount) {
        return;
    }

    vec3 particlePos = particles.positions[particleIndex].xyz;
    float particleMass = particles.positions[particleIndex].w;

    // Convert world position to grid coordinates
    vec3 gridPos = (particlePos - pc.gridOrigin) / pc.voxelSize;

    // Calculate splat bounds in grid space
    float splatRadiusVoxels = pc.splatRadius / pc.voxelSize;
    ivec3 minCoord = ivec3(floor(gridPos - splatRadiusVoxels));
    ivec3 maxCoord = ivec3(ceil(gridPos + splatRadiusVoxels));

    // Clamp to grid bounds
    minCoord = max(minCoord, ivec3(0));
    maxCoord = min(maxCoord, ivec3(pc.gridDimensions) - 1);

    // Splat particle density using Gaussian kernel
    for (int z = minCoord.z; z <= maxCoord.z; z++) {
        for (int y = minCoord.y; y <= maxCoord.y; y++) {
            for (int x = minCoord.x; x <= maxCoord.x; x++) {
                ivec3 voxelCoord = ivec3(x, y, z);

                // Calculate distance from particle to voxel center
                vec3 voxelCenter = vec3(voxelCoord) + 0.5;
                vec3 delta = voxelCenter - gridPos;
                float distance = length(delta);

                // Skip if outside splat radius
                if (distance > splatRadiusVoxels) {
                    continue;
                }

                // Gaussian falloff kernel
                float sigma = splatRadiusVoxels * 0.33; // 3-sigma covers most of radius
                float weight = exp(-0.5 * (distance * distance) / (sigma * sigma));
                float contribution = particleMass * weight;

                // Add contribution to density grid
                // Note: For RTV-2002, we clear the grid first then accumulate
                // Race conditions are acceptable for now since we get averaging effect
                float currentDensity = imageLoad(densityGrid, voxelCoord).r;
                imageStore(densityGrid, voxelCoord, vec4(currentDensity + contribution, 0.0, 0.0, 0.0));
            }
        }
    }
}